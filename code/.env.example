# =============================================================================
# BICEC VeriPass — Variables d'environnement
# Copier ce fichier en .env et remplir toutes les valeurs
# NE JAMAIS committer .env dans git
# =============================================================================

# ── Environnement ──────────────────────────────────────────────────────────
ENV=development          # development | production
DEBUG=true
VITE_SENTRY_DSN=         # DSN Sentry pour mobile (laisser vide pour désactiver)
SENTRY_DSN=              # DSN Sentry pour le backend FastAPI

# ── Base de données PostgreSQL ─────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=veripass
POSTGRES_USER=veripass_user
POSTGRES_PASSWORD=changeme_strong_password

# URL complète (utilisée par SQLAlchemy / Alembic)
DATABASE_URL=postgresql+asyncpg://veripass_user:changeme_strong_password@postgres:5432/veripass

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=changeme_256bit_random_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=8       # Back-office
JWT_CLIENT_TOKEN_EXPIRE_HOURS=24      # PWA Marie

# ── Chiffrement AES-256 (biométrie, GPS) ───────────────────────────────────
AES_SECRET_KEY=changeme_32bytes_aes_key_here_base64

# ── Orange Cameroon SMS API ────────────────────────────────────────────────
OTP_MODE=dev_local               # dev_local | orange  (dev_local interdit en prod)
OTP_FALLBACK_EMAIL=true
OTP_FALLBACK_EMAIL_ADDRESS=     # Email de fallback si SMS échoue (dev/staging uniquement)
ORANGE_APP_ID=changeme_orange_app_id
ORANGE_CLIENT_ID=changeme
ORANGE_CLIENT_SECRET=changeme
ORANGE_BASE_URL=https://api.orange.com/smsmessaging/v1

# ── Email (reset mot de passe Admin IT) ────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@bicec.cm
SMTP_PASSWORD=changeme
SMTP_FROM=VeriPass <noreply@bicec.cm>

# ── Celery ─────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Flower (Celery Monitoring) ─────────────────────────────────────────────
FLOWER_USER=admin                    # Username pour accès Flower UI
FLOWER_PASSWORD=changeme_flower_pwd  # Password pour accès Flower UI (http://localhost:5555)

# ── Modèles AI (chemins dans le container) ─────────────────────────────────
PADDLE_OCR_MODEL_DIR=/data/models/paddleocr
GLM_OCR_MODEL_DIR=/data/models/glm-ocr
GLM_OCR_CLI_PATH=llama-mtmd-cli
GLM_OCR_MODEL_PATH=/opt/models-offline/glm-ocr/GLM-OCR.i1-Q4_K_M.gguf
GLM_OCR_MMPROJ_PATH=/opt/models-offline/glm-ocr/mmproj-GLM-OCR-Q8_0.gguf
GLM_OCR_QUEUE=glm_ocr_jobs
GLM_OCR_TIMEOUT_SECONDS=90
MINIFASNET_ENABLED=true
MINIFASNET_MODEL_PATH=/opt/models-offline/minifasnet/MiniFASNetV2.onnx
MINIFASNET_MODEL_URL=                     # Optionnel: seulement pour docker compose --profile online-init run model_init
# SHA-256 attendu du ONNX pinne offline, obligatoire avant pilote/prod
MINIFASNET_MODEL_SHA256=
MINIFASNET_CROP_SCALE=2.7
MINIFASNET_INPUT_SIZE=80
MINIFASNET_LIVE_CLASS_INDEX=1             # 1 pour les exports yakhyo/minivision, 0 pour certains exports HF
DEEPFACE_MODEL_DIR=/data/models/deepface

# ── Stockage fichiers ──────────────────────────────────────────────────────
DOCUMENTS_BASE_PATH=/data/documents
STORAGE_PATH=/data/documents        # Alias utilisé par docker-compose
MODELS_PATH=/data/models            # Alias utilisé par docker-compose
MAX_UPLOAD_SIZE_MB=10

# ── Docker volumes critiques ────────────────────────────────────────────────
# Ces volumes sont declares comme "external" dans docker-compose.yml pour
# empecher Compose de proposer une recreation destructive quand leur definition
# change. En production, pointer vers les vrais volumes persistants existants.
VP_DOCUMENTS_VOLUME_NAME=code_documents_storage
VP_DB_VOLUME_NAME=code_db_storage
VP_DB_BACKUPS_VOLUME_NAME=code_db_backups

# ── Backups ────────────────────────────────────────────────────────────────
# ENABLE_BACKUPS: mettre à true uniquement quand l'infra backup est configurée.
# Empêche l'exécution accidentelle en dev/CI sans cible de backup.
ENABLE_BACKUPS=false
BACKUP_RETENTION_DAYS=7
# BACKUP_ENCRYPTION_KEY: passphrase AES-256 dédiée pour les archives GPG des images KYC.
# DOIT être différente de JWT_SECRET. Utiliser un secrets manager en production.
# Obligatoire si ENABLE_BACKUPS=true en production.
BACKUP_ENCRYPTION_KEY=changeme_dedicated_backup_passphrase_here

# ── Oracle Cloud GLM-OCR ─────────────────────────────────────────────────
OCR_ONLINE=false                     # true → GLM-OCR via Oracle Cloud au lieu de local
OCR_CLOUD_URL=                       # https://<ip-ou-dns-oracle>/ocr
OCR_CLOUD_API_KEY=                   # sk-glm-ocr-... (doit matcher le serveur Oracle)
OCR_CLOUD_KEY=                       # base64 d'une clé AES-256 (32 bytes) — doit matcher le serveur Oracle

# ── Seuils OCR ─────────────────────────────────────────────────────────────
OCR_CONFIDENCE_THRESHOLD=85          # % — en dessous → fallback GLM-OCR
OCR_PADDLE_TIMEOUT_S=5
OCR_GLM_TIMEOUT_S=30

# ── Seuils biométrie ───────────────────────────────────────────────────────
LIVENESS_MIN_SCORE=70                # % — legacy; le backend utilise le seuil de mouvement landmarks interne
FACE_MATCH_MIN_SCORE=0.80            # score DeepFace 0..1 — en dessous → review prioritaire
ANTI_SPOOFING_MIN_SCORE=0.70         # score MiniFASNet 0..1 — en dessous → strike liveness
LIVENESS_MAX_STRIKES=3

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://localhost:3000,https://localhost:3001

# ── Admin IT seed ──────────────────────────────────────────────────────────
ADMIN_IT_SEED_EMAIL=admin@bicec.cm
ADMIN_IT_SEED_PASSWORD=changeme_first_login_password

# ── Variables utilisées par docker-compose.yml ──────────────────────────
# Ces variables sont référencées par docker-compose.yml.
# Elles doivent être cohérentes avec les valeurs des sections ci-dessus.
DB_PASSWORD=changeme_strong_password            # Doit correspondre à POSTGRES_PASSWORD
JWT_SECRET=changeme_256bit_random_secret_key_here  # Doit correspondre à JWT_SECRET_KEY
ENVIRONMENT=development                         # Doit correspondre à ENV
APP_VERSION=0.1.0                               # Version affichée dans les frontends
SENTRY_DSN_BACKEND=                             # DSN Sentry pour le backend FastAPI
VITE_SENTRY_DSN_MOBILE=                         # DSN Sentry pour la PWA mobile
VITE_SENTRY_DSN_BACKOFFICE=                     # DSN Sentry pour le backoffice
OFFLINE_MODELS_DIR=./infra/models-offline       # Chemin local vers les modèles OCR/PAD offline
ORANGE_SMS_CLIENT_ID=                           # Alias docker-compose pour ORANGE_CLIENT_ID
ORANGE_SMS_CLIENT_SECRET=                       # Alias docker-compose pour ORANGE_CLIENT_SECRET
SMTP_TLS=false                                  # TLS pour SMTP
