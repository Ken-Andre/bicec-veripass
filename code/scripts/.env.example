# ============================================================
# Docker Prune Script Configuration
# ============================================================
# Copy to .env and customize as needed

# Disk usage threshold (percentage) to trigger cleanup
DOCKER_PRUNE_THRESHOLD=85

# Log file path
# Linux/macOS: /var/log/docker_prune.log
# Windows: ../logs/docker_prune.log
DOCKER_PRUNE_LOG=/var/log/docker_prune.log
