{
  "enabled": true,
  "name": "Decrypt all .env.enc",
  "description": "Déchiffre manuellement tous les .env.enc du repo vers new.env (sans écraser les .env existants)",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "bash code/scripts/decrypt-all-envs.sh"
  }
}